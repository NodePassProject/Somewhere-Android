root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4

[*.xml]
indent_size = 4

[*.{c,h}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{toml,yml,yaml}]
indent_size = 2

[*.{kt,kts}]
# Compose convention: @Composable functions are PascalCase by design.
# This is ktlint's own escape hatch for it, not a suppression of the rule.
ktlint_function_naming_ignore_when_annotated_with = Composable
