<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Somewhere">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Somewhere">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- D-10: own scheme is the preferred handler; the donor family's
                 scheme is also accepted so existing dashboard import buttons
                 still reach this client. `nowhere` is the node-import scheme
                 emitted by NowhereDash. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="somewhere" />
                <data android:scheme="nowhere" />
                <data android:scheme="anywhere" />
            </intent-filter>
        </activity>
    </application>
</manifest>
