<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Package visibility, API 30 and up. Without this the per-app screen
         sees almost nothing: `getInstalledApplications` returns only packages
         this app has declared an interest in.

         Declaring the launcher intent rather than asking for
         QUERY_ALL_PACKAGES is deliberate. It reveals every application with an
         icon in the launcher, which is very nearly the set anyone would want
         to route, and it is not policy-sensitive on the Play store. The
         permission that would reveal the rest is D-16, and the screen says the
         list is partial rather than pretending otherwise. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- Without this every socket fails with an IOException, which the dialer
         reports as "the Portal did not answer" — an honest message about a
         connection that was never allowed to be attempted. Found on a device:
         nothing in the build, the tests or lint notices a client that cannot
         reach the network, because the unit tests run on a JVM that can. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The tunnel has to survive the app being backgrounded, which is the
         normal case: nobody watches a VPN. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- API 34 requires the permission that matches the declared service type.
         There is no VPN type in the platform — `ServiceInfo` has sixteen
         FOREGROUND_SERVICE_TYPE_* constants and none of them is one — so the
         type is `specialUse` with the subtype named in a property below. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- API 33 and up. Without it the service still runs, but its ongoing
         notification is not shown — leaving a tunnel carrying every packet
         the device sends with nothing on screen saying so. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".SomewhereApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.Somewhere">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:theme="@style/Theme.Somewhere">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- D-10: own scheme is the preferred handler; the donor family's
                 scheme is also accepted so existing dashboard import buttons
                 still reach this client. `nowhere` is the node-import scheme
                 emitted by NowhereDash. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="somewhere" />
                <data android:scheme="nowhere" />
                <data android:scheme="anywhere" />
            </intent-filter>
        </activity>
        <!-- The tunnel.

             `BIND_VPN_SERVICE` is what makes this a VPN as far as the system is
             concerned: only a service holding it may call `establish()`, and
             the permission is enforced against the *system*, which is why it
             sits here rather than in a uses-permission. Without the
             intent-filter the consent dialog cannot find the service.

             `specialUse` because the platform has no VPN foreground service
             type. The subtype property below is the required justification.
             The donor suppresses lint's ForegroundServiceType check here; that
             turned out to be unnecessary — with the property present lint is
             satisfied, and a suppression nobody needs is one nobody questions
             later. -->
        <service
            android:name=".vpn.SomewhereVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn" />
        </service>
    </application>
</manifest>
