<?xml version="1.0" encoding="utf-8"?>
<!--
    Two directions, drawn apart.

    This is the app's one idea. Upstream and downstream are separate colours
    everywhere in this client — design-system rule: direction colour is not
    decoration — and the icon says the same thing before anything is opened.
    Unequal lengths because the two directions are not symmetric: a client
    sends little and receives much.

    Teal is `upstream`, amber is `downstream`, the same two hues the home
    screen uses. Nothing here is the brand violet: that is the ground.

    Geometry: an adaptive icon is a 108x108 canvas of which only the middle
    66% is guaranteed visible. The mark spans x 27..81 and y 32..76, centred
    on (54, 54), which leaves the whole of it inside that with room for a
    launcher's mask to be rounder than expected.

    The shafts are 48 and 32 units, a ratio of two to three. The first version
    made them 48 and 41, which reads fine in colour and not at all in the
    monochrome layer, where the hues are gone and length is the only thing
    left saying there are two directions. Fifteen percent is not a difference
    at launcher size; a third is.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Upstream: longer, pointing away. -->
    <path
        android:pathData="M27,41 L75,41"
        android:strokeColor="#55C4CE"
        android:strokeWidth="9"
        android:strokeLineCap="round" />
    <path
        android:pathData="M68,32 L81,41 L68,50"
        android:strokeColor="#55C4CE"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Downstream: shorter, pointing back. -->
    <path
        android:pathData="M81,67 L49,67"
        android:strokeColor="#E09B55"
        android:strokeWidth="9"
        android:strokeLineCap="round" />
    <path
        android:pathData="M49,58 L36,67 L49,76"
        android:strokeColor="#E09B55"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
