    <!-- The brand name is not translated: Chrome is Chrome in every locale, and
         so is this. Marked explicitly so lint does not ask for a translation
         that should never exist. -->
    <string name="app_name" translatable="false">Somewhere</string>

    <!-- Protocol identifiers. Never translated: a user pasting one of these into
         an issue must match the specification, the source, and another user's
         log from a different locale. See docs/i18n.md. -->
