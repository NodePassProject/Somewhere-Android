# ── Never commit ────────────────────────────────────────────────────────────

# Signing material and machine-local SDK paths
local.properties
*.jks
*.keystore

# Runtime output and logs - may contain node addresses, tokens, real traffic data
*.log

# Claude project context and local drafts
.claude/
CLAUDE.local.md
*.local.md

# ── Build output ────────────────────────────────────────────────────────────
.gradle/
build/
.kotlin/
*.apk
*.aab

# ── Ordinary ────────────────────────────────────────────────────────────────
.DS_Store
*.swp
.idea/
__pycache__/
*.pyc

# CMake's per-ABI working tree. Survives `gradlew clean` by design, which is
# exactly why it has to be ignored rather than relied on being cleaned.
.cxx/

# The QUIC stack: fetched at pinned commits and built into a cache, never
# committed. See tools/quic/DEPENDENCIES and D-17.
.quic-deps/
